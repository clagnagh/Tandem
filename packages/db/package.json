{
  "name": "@tandem/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./testing": "./src/testing.ts",
    "./seed": "./src/seed.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts up",
    "rollback": "node --env-file-if-exists=../../.env scripts/migrate.ts down",
    "seed": "node --env-file-if-exists=../../.env scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tandem/shared": "workspace:*",
    "drizzle-orm": "~0.45.3",
    "fractional-indexing": "^4.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@tandem/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "~0.31.11"
  }
}
