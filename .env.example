# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# Postgres (docker compose maps it to localhost:5432)
DATABASE_URL=postgresql://tandem:tandem@localhost:5432/tandem

# Redis (rate limits, later queues and pub/sub)
REDIS_URL=redis://localhost:6379

# API server
SERVER_PORT=4000
LOG_LEVEL=info

# Web app: where Next.js forwards /api/* (see docs/adr/0002)
API_ORIGIN=http://localhost:4000

# Public URL the browser uses. Auth checks the Origin header against it.
APP_URL=http://localhost:3000

# Auth (Phase 1 step 4). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email. Locally this is Mailpit (web UI at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Tandem <no-reply@tandem.local>"
