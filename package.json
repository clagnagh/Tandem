{
  "name": "tandem",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tandem/server --filter @tandem/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @tandem/web test:e2e",
    "db:generate": "pnpm --filter @tandem/db generate",
    "db:migrate": "pnpm --filter @tandem/db migrate",
    "db:rollback": "pnpm --filter @tandem/db rollback",
    "db:seed": "pnpm --filter @tandem/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tandem/config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
